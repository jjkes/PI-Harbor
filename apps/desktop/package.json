{
  "name": "@pi-harbor/desktop",
  "version": "0.2.0",
  "desktopName": "pi-harbor.desktop",
  "private": true,
  "description": "PI-Harbor Desktop Electron application",
  "homepage": "https://gitlab.jjkets.top/jjkets/pi-harbor",
  "author": {
    "name": "jjkes",
    "email": "a1204219221@163.com"
  },
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "build:deps": "pnpm --filter '@pi-harbor/desktop^...' build",
    "predev": "pnpm run build:deps && cargo build --manifest-path ../../Cargo.toml -p host-core",
    "dev": "node ../../scripts/dev-electron.mjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "lint": "node ../../scripts/check-style-tokens.mjs",
    "clean": "node -e \"fs.rmSync('out',{recursive:true,force:true});fs.rmSync('dist',{recursive:true,force:true})\"",
    "build:host-release": "cargo build --release --manifest-path ../../Cargo.toml -p host-core",
    "bundle:runtime": "pnpm -C ../../packages/agent-runtime bundle",
    "pack": "pnpm run build:deps && pnpm run build:host-release && pnpm run bundle:runtime && electron-vite build && electron-builder --dir",
    "dist": "pnpm run build:deps && pnpm run build:host-release && pnpm run bundle:runtime && electron-vite build && node ../../scripts/build-desktop-release.mjs",
    "dist:mac": "pnpm run build:deps && pnpm run build:host-release && pnpm run bundle:runtime && electron-vite build && electron-builder --mac --publish never",
    "dist:win": "pnpm run build:deps && pnpm run build:host-release && pnpm run bundle:runtime && electron-vite build && node ../../scripts/build-desktop-release.mjs win",
    "dist:linux": "pnpm run build:deps && pnpm run build:host-release && pnpm run bundle:runtime && electron-vite build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@picovoice/pvrecorder-node": "1.2.9",
    "node-llama-cpp": "3.22.2",
    "transcribe-cpp": "0.2.2",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-mcp": "1.5.0",
    "@pi-harbor/agent-host": "workspace:*",
    "@pi-harbor/agent-runtime": "workspace:*",
    "@pi-harbor/host-runtime": "workspace:*",
    "@pi-harbor/i18n": "workspace:*",
    "@pi-harbor/plugin-devkit": "workspace:*",
    "@pi-harbor/plugin-sdk": "workspace:*",
    "@pi-harbor/racp": "workspace:*",
    "@pi-harbor/shared": "workspace:*",
    "@pi-harbor/voice-runtime": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.6.0",
    "dompurify": "^3.4.17",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "i18next": "^26.3.6",
    "katex": "^0.16.47",
    "lucide-react": "^1.31.0",
    "mermaid": "^11.16.1",
    "pinyin-pro": "3.29.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^15.6.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "vite": "^7.3.6",
    "ws": "8.21.1",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "top.jjkets.pi-harbor",
    "productName": "PI-Harbor Desktop",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://gitlab.jjkets.top/jjkets/pi-harbor/-/releases/permalink/latest/downloads"
      }
    ],
    "extraMetadata": {
      "piDistribution": "installed"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!**/*.map",
      "!**/node_modules/*/{test,tests,__tests__,powered-test,example,examples}/**",
      "!**/node_modules/**/*.{test,spec}.{js,cjs,mjs}",
      "!**/node_modules/node-addon-api/tools/**",
      "!**/node_modules/node-addon-api/*.{c,gyp,gypi,h,js,json}",
      "!**/node_modules/node-addon-api/README.md"
    ],
    "electronLanguages": [
      "en-US",
      "zh-CN",
      "zh_CN",
      "zh-TW",
      "zh_TW",
      "tr",
      "de",
      "es",
      "fr",
      "ko",
      "pt-BR",
      "pt_BR"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "tray-icon.png"
      },
      {
        "from": "../../packages/agent-runtime/dist-bundle",
        "to": "agent-runtime"
      },
      {
        "from": "resources/skills",
        "to": "skills"
      },
      {
        "from": "resources/gen-ui",
        "to": "gen-ui"
      },
      {
        "from": "resources/plugins",
        "to": "plugins"
      },
      {
        "from": "resources/models.dev",
        "to": "models.dev"
      }
    ],
    "mac": {
      "artifactName": "PI-Harbor-Desktop-${version}-${arch}-mac.${ext}",
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "PI-Harbor Desktop needs local network access so agents can reach OpenAI-compatible providers, Ollama, and other AI endpoints running on your LAN. / PI-Harbor Desktop 需要本地网络访问权限，以便助手请求同一局域网中的 OpenAI 兼容服务、Ollama 等本地 AI 端点。",
        "NSMicrophoneUsageDescription": "PI-Harbor Desktop uses the microphone for Live voice calls and authorized plugin audio access. / PI-Harbor Desktop 使用麦克风进行实时语音通话，以及你已授权的插件音频访问。",
        "NSBonjourServices": [
          "_http._tcp",
          "_https._tcp"
        ]
      },
      "extraResources": [
        {
          "from": "../../target/release/pi-harbor-host-core",
          "to": "bin/pi-harbor-host-core"
        },
        {
          "from": "build/tray-icon-mac.png",
          "to": "tray-icon-mac.png"
        }
      ]
    },
    "dmg": {
      "artifactName": "PI-Harbor-Desktop-${version}-${arch}.${ext}",
      "background": "build/dmg-background.png",
      "icon": "build/icon.icns",
      "window": {
        "width": 720,
        "height": 440
      },
      "iconSize": 128,
      "iconTextSize": 12,
      "contents": [
        {
          "x": 180,
          "y": 196
        },
        {
          "x": 540,
          "y": 196,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "executableName": "pi-harbor",
      "artifactName": "PI-Harbor-Desktop-Portable-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "resources/app-update.yml",
          "to": "app-update.yml"
        },
        {
          "from": "../../target/release/pi-harbor-host-core.exe",
          "to": "bin/pi-harbor-host-core.exe"
        },
        {
          "from": "build/icon.ico",
          "to": "app-icon.ico"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "PI-Harbor Desktop",
      "artifactName": "PI-Harbor-Desktop-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "PI-Harbor-Desktop-Portable-${version}.${ext}"
    },
    "deb": {
      "packageName": "pi-harbor",
      "artifactName": "pi-harbor_${version}_${arch}.${ext}"
    },
    "rpm": {
      "packageName": "pi-harbor",
      "artifactName": "pi-harbor-${version}-${arch}.${ext}",
      "fpm": [
        "--rpm-rpmbuild-define",
        "_build_id_links none"
      ]
    },
    "linux": {
      "executableName": "pi-harbor",
      "syncDesktopName": true,
      "artifactName": "PI-Harbor-Desktop-${version}-linux-${arch}.${ext}",
      "target": [
        {
          "target": "AppImage"
        },
        {
          "target": "deb"
        },
        {
          "target": "rpm"
        }
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "../../target/release/pi-harbor-host-core",
          "to": "bin/pi-harbor-host-core"
        }
      ]
    },
    "asarUnpack": [
      "node_modules/transcribe-cpp/**/*.node",
      "node_modules/transcribe-cpp/**/bin/**",
      "node_modules/@picovoice/pvrecorder-node/**/*.node",
      "node_modules/@picovoice/pvrecorder-node/**/lib/**",
      "node_modules/koffi/**/*.node",
      "node_modules/@koromix/**",
      "node_modules/@transcribe-cpp/**",
      "node_modules/node-llama-cpp/bins/**",
      "node_modules/node-llama-cpp/llama/localBuilds/**",
      "node_modules/@node-llama-cpp/**"
    ],
    "asar": {
      "smartUnpack": false
    }
  }
}
